{
  "name": "sensitivity-converter",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first FPS mouse sensitivity converter: cm/360, eDPI, profiles, comparison. English & Arabic.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "electron:start": "npm run build && electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "clsx": "^2.1.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.69.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zustand": "^5.0.16"
  },
  "engines": {
    "node": ">=20"
  },
  "productName": "Aimless",
  "author": "pzxe",
  "homepage": "https://github.com/pzxe/Aimless",
  "main": "electron/main.cjs",
  "build": {
    "appId": "io.github.pzxe.aimless",
    "productName": "Aimless",
    "copyright": "Copyright (c) 2026 Sensitivity Converter contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "build/Run-Aimless.bat",
        "to": "Run-Aimless.bat"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Aimless-v${version}-Windows-NoInstall.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Aimless-v${version}-Portable.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
