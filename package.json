{
  "name": "aimless",
  "private": true,
  "version": "2.5.3",
  "description": "Aimless: local-first FPS sensitivity toolkit. cm/360 converter, tournament brackets, mousepad visualizer, ADS and polling tools. 5 languages.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tweet": "node --test scripts/tweet-length.test.mjs",
    "typecheck": "tsc -b --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "electron:start": "npm run build && electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "gifs": "node scripts/gifs.mjs",
    "gifs:desktop": "node scripts/gifs-desktop.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "clsx": "^2.1.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "gifenc": "^1.0.3",
    "lucide-react": "^1.69.0",
    "playwright-core": "^1.65.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zustand": "^5.0.16"
  },
  "engines": {
    "node": ">=20"
  },
  "productName": "Aimless",
  "author": "pzxe",
  "homepage": "https://github.com/pzxe/Aimless",
  "main": "electron/main.cjs",
  "build": {
    "appId": "io.github.pzxe.aimless",
    "productName": "Aimless",
    "copyright": "Copyright (c) 2026 Sensitivity Converter contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/updater.cjs",
      "electron/update-core.mjs",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "build/Run-Aimless.bat",
        "to": "Run-Aimless.bat"
      }
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "pzxe",
        "repo": "Aimless"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Aimless-v${version}-Windows-NoInstall.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Aimless-v${version}-Portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "artifactName": "Aimless-v${version}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Aimless",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "Aimless",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
