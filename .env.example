# Optional: lets `node scripts/post-tweet.mjs --api` post through the X API v2 instead of opening compose tabs.
# Create a project at https://developer.x.com with "Read and write" permission, then generate these. Never commit .env.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Or, instead of the four keys above, an OAuth 2.0 user-context access token with the tweet.write scope:
# X_USER_ACCESS_TOKEN=
